{
  "name": "customer-support-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "NEXT_PUBLIC_INCLUDE_LEFT_SIDEBAR=true NEXT_PUBLIC_INCLUDE_RIGHT_SIDEBAR=true next dev",
    "build": "NEXT_PUBLIC_INCLUDE_LEFT_SIDEBAR=true NEXT_PUBLIC_INCLUDE_RIGHT_SIDEBAR=true next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "dev:full": "npm run dev",
    "dev:left": "NEXT_PUBLIC_INCLUDE_LEFT_SIDEBAR=true NEXT_PUBLIC_INCLUDE_RIGHT_SIDEBAR=false next dev",
    "dev:right": "NEXT_PUBLIC_INCLUDE_LEFT_SIDEBAR=false NEXT_PUBLIC_INCLUDE_RIGHT_SIDEBAR=true next dev",
    "dev:chat": "NEXT_PUBLIC_INCLUDE_LEFT_SIDEBAR=false NEXT_PUBLIC_INCLUDE_RIGHT_SIDEBAR=false next dev",
    "build:full": "npm run build",
    "build:left": "NEXT_PUBLIC_INCLUDE_LEFT_SIDEBAR=true NEXT_PUBLIC_INCLUDE_RIGHT_SIDEBAR=false next build",
    "build:right": "NEXT_PUBLIC_INCLUDE_LEFT_SIDEBAR=false NEXT_PUBLIC_INCLUDE_RIGHT_SIDEBAR=true next build",
    "build:chat": "NEXT_PUBLIC_INCLUDE_LEFT_SIDEBAR=false NEXT_PUBLIC_INCLUDE_RIGHT_SIDEBAR=false next build",
    "test:anthropic": "node --env-file-if-exists=.env.local scripts/test-anthropic.mjs",
    "test:kb": "AWS_PROFILE= node --env-file-if-exists=.env.local scripts/test-kb.mjs",
    "eval:retrieval": "AWS_PROFILE= node --env-file-if-exists=.env.local scripts/eval-retrieval.mjs",
    "eval:retrieval:sweep": "AWS_PROFILE= node --env-file-if-exists=.env.local scripts/eval-retrieval-sweep.mjs",
    "eval:followups": "AWS_PROFILE= node --env-file-if-exists=.env.local scripts/eval-followups.mjs",
    "eval:reranking": "AWS_PROFILE= node --env-file-if-exists=.env.local scripts/eval-reranking.mjs",
    "eval:sim:prepare": "AWS_PROFILE= node --env-file-if-exists=.env.local scripts/eval-sim-prepare.mjs",
    "eval:sim:rerun:prepare": "AWS_PROFILE= node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings scripts/eval-sim-rerun-prepare.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1169.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "highlight.js": "^11.9.0",
    "lucide-react": "^0.577.0",
    "next": "^15.5.29",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.0",
    "rehype-raw": "^7.0.0",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.33"
    }
  }
}
