# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; this example file is safe to commit.

# Claude (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# AWS Bedrock knowledge base: access key for the stack's app user (AppUserName output)
# The "B" prefix is required because AWS Amplify rejects variable names starting with AWS.
BAWS_ACCESS_KEY_ID=
BAWS_SECRET_ACCESS_KEY=
KNOWLEDGE_BASE_ID=
# Optional, defaults to us-east-1
BAWS_REGION=

# Owner password for /owner (unlocks all models, no limits); also signs the owner cookie
SITE_PASSWORD=

# Upstash Redis for visitor rate limits (Vercel's KV_REST_API_URL / KV_REST_API_TOKEN also work)
# Without these, visitor requests are refused.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
